---
import { SUGGESTED_AMOUNTS } from "@/consts";

import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import GoalsData from "@/data/goals.json";
import Layout from "@/layouts/Layout.astro";
import Title from "@/components/shared/Title.astro";
import SwiperCarousel from "@/components/shared/swiper/SwiperCarousel";

export const getStaticPaths = (async () => {
  const goals = GoalsData;
  return goals.map((goal) => ({
    params: { id: goal.id },
    props: { goal },
  }));
}) satisfies GetStaticPaths;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { goal } = Astro.props;
const {
  title,
  description,
  image_url,
  product_url,
  target_amount,
  current_amount,
  id,
  rewards,
} = goal;

const progress = (current_amount / target_amount) * 100;
const suggestedAmounts = SUGGESTED_AMOUNTS;
export const prerender = true;
---

<Layout showHeader={false}>
  <main
    class="flex px-4 pt-4 flex-col gap-10 w-full h-full min-h-screen max-w-300 mx-auto pb-10"
  >
    <div
      class="flex items-center w-full h-60 md:h-80 overflow-hidden group bg-center bg-cover bg-no-repeat relative rounded-xl"
      transition:name={`goal-image-${id}`}
      transition:persist
      style={`background-image:url(${image_url})`}
    >
      <a
        href="/"
        transition:name={`index-link-${id}`}
        class="z-20 absolute top-4 left-4 text-gray-200 text-sm flex items-center gap-2 w-fit font-extrabold hover:text-cyan-400 transition-colors cursor-pointer group"
      >
        <iconify-icon
          class="group-hover:-translate-x-1"
          width="20"
          height="20"
          icon="akar-icons:arrow-left"></iconify-icon>
        Volver</a
      >
      <Title
        title={title}
        isGradient={true}
        class="z-20 text-3xl md:text-5xl font-extrabold mb-10 absolute top-50 left-[50%] translate-x-[-50%]"
        transition:name={`goal-title-${id}`}
      />
      <div
        class="overlay backdrop-blur bg-linear-to-t from-black/98 via-black/80 to-black/50 z-10 absolute w-full h-full pointer-events-none"
      >
      </div>
    </div>
    <div class="w-full flex gap-6 justify-between">
      <div
        class="flex flex-col gap-8 px-1 w-full"
        transition:name={`goal-description-${id}`}
      >
        <p
          class="text-balance text-gray-200 whitespace-pre-line text-base"
        >
          {description}
        </p>
        {
          product_url && (
            <a
              href={product_url}
              target="_blank"
              rel="noopener noreferrer nofollow"
              class="bg-amethyst-950 w-fit text-gray-200 px-3 py-2 rounded-md hover:bg-amethyst-800 transition-colors cursor-pointer text-base"
            >
              Visitar el sitio del producto
            </a>
          )
        }
        <div class="flex flex-col gap-3">
          <Title
            as="h3"
            title="Rewards de la meta"
            isGradient={true}
            class="text-left"
          />
          <ul class="pl-10">
            {
              rewards.map((reward) => (
                <li class="text-gray-200 list-disc text-base">{reward}</li>
              ))
            }
          </ul>
        </div>
      </div>

      <div
        class="flex flex-col w-full items-start justify-start h-full sticky top-0 bg-amethyst-300 p-4 rounded-xl"
        transition:name={`donation-form-${id}`}
      >
        <Title
          as="h2"
          title="Donaciones"
          class="text-left font-black text-4xl text-amethyst-900"

        />
        <div class="flex flex-col gap-2 py-10 w-full">
          <label
            class="font-bold text-amethyst-800 text-lg"
            for={`amount-${id}`}>{progress.toFixed()}%</label
          >
          <progress
            class="w-full"
            id={`amount-${id}`}
            max="100"
            value={progress}
          >
            {progress}%
          </progress>
        </div>

        <form
          data-donation-form
          data-goal-id={id}
          action="/api/donations/checkout"
          method="post"
          class="flex flex-col gap-2 w-full"
        >
          <input type="hidden" name="goalId" value={id} />

          <div class="flex items-center gap-2 flex-wrap text-sm font-bold">
            {
              suggestedAmounts.map((amount) => (
                <button
                  type="button"
                  data-amount={amount}
                  class="text-xl bg-amethyst-700 text-gray-100 px-3 py-1 rounded-md hover:bg-amethyst-800 transition-colors cursor-pointer"
                >
                  ${amount}
                </button>
              ))
            }
            <input
              type="number"
              id={`amount-input-${id}`}
              name="amount"
              min="1"
              step="1"
              placeholder="Otra cantidad"
              aria-label="Monto libre en dólares"
              class="text-xl border text-gray-900 bg-amethyst-200 border-gray-300 rounded-md px-2 py-1 w-100 focus:outline-none shadow-amethyst-500 shadow-sm focus:ring-2 focus:ring-amethyst-500 focus:border-transparent"
            />
          </div>

          <label
            class="flex items-center gap-2 text-sm text-amethyst-900 cursor-pointer"
          >
            <input
              type="checkbox"
              name="coverFees"
              data-cover-fees
              class="accent-amethyst-500 cursor-pointer"
            />
            Cubrir comisión de Lemon Squeezy
            <span data-fee class="font-bold text-amethyst-950"></span>
          </label>

          <p data-total hidden class="text-sm font-bold text-amethyst-950"></p>
          <p data-form-error hidden class="text-sm text-red-500"></p>

          <div class="flex items-center gap-4 w-full mt-auto">
            <button
              type="submit"
              class="flex items-center justify-center gap-2 font-bold bg-amethyst-900 w-full text-gray-100 text-base px-3 py-2 rounded-md hover:bg-amethyst-800 transition-colors cursor-pointer shadow-lg"
            >
              Donar
              <iconify-icon
                width="20"
                height="20"
                icon="ant-design:heart-twotone"
                style="fill:#ff1e6c; color: #ff1e6c;"></iconify-icon>
            </button>
          </div>
        </form>
      </div>
    </div>
    <SwiperCarousel client:visible />
  </main>
</Layout>


<style is:inline>
  progress::-webkit-progress-bar {
    border-radius: 5px;
    height: 8px;
    filter: drop-shadow(1px 1px 2px rgba(0, 0, 0, 0.9));
  }

  progress::-webkit-progress-value {
    border-radius: 5px;
    background-color: var(--color-amethyst-500);
  }
  progress::-webkit-progress-bar {
    background-color: rgb(35, 5, 77);
  }

  /* ::-webkit-inner-spin-button, ::-webkit-outer-spin-button{
    display: none;
  } */
</style>

<script>
  import "@/components/goals/utils/amount";
</script>
