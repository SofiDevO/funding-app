---
import { SUGGESTED_AMOUNTS } from "@/consts";

import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import GoalsData from "@/data/goals.json";
import Layout from "@/layouts/Layout.astro";
import Title from "@/components/shared/Title.astro";
import SwiperCarousel from "@/components/shared/swiper/SwiperCarousel";
import Banner from "./__components/Banner.astro";
import DonationCard from "./__components/DonationCard.astro";

export const getStaticPaths = (async () => {
  const goals = GoalsData;
  return goals.map((goal) => ({
    params: { id: goal.id },
    props: { goal },
  }));
}) satisfies GetStaticPaths;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { goal } = Astro.props;
const {
  title,
  description,
  image_url,
  gallery,
  product_url,
  target_amount,
  current_amount,
  id,
  rewards,
} = goal;

const progress = (current_amount / target_amount) * 100;
const suggestedAmounts = SUGGESTED_AMOUNTS;
export const prerender = true;


---

<Layout showHeader={false}>
  <main
    class="flex px-4 pt-4 flex-col gap-10 w-full h-full min-h-screen max-w-300 mx-auto pb-10"
  >
    <Banner  title={title} image_url={image_url} id={id} />
    <div class="w-full flex gap-6 justify-between">
      <div
        class="flex flex-col gap-8 px-1 w-full"
        transition:name={`goal-description-${id}`}
      >
        <p class="text-balance text-gray-200 whitespace-pre-line text-base">
          {description}
        </p>
        {
          product_url && (
            <a
              href={product_url}
              target="_blank"
              rel="noopener noreferrer nofollow"
              class="bg-amethyst-950 w-fit text-gray-200 px-3 py-2 rounded-md hover:bg-amethyst-800 transition-colors cursor-pointer text-base"
            >
              Visitar el sitio del producto
            </a>
          )
        }
        <div class="flex flex-col gap-3">
          <Title
            as="h3"
            title="Rewards de la meta"
            isGradient={true}
            class="text-left"
          />
          <ul class="pl-10">
            {
              rewards.map((reward) => (
                <li class="text-gray-200 list-disc text-base">{reward}</li>
              ))
            }
          </ul>
        </div>
      </div>

      <DonationCard id={id} progress={progress} suggestedAmounts={suggestedAmounts} />
    </div>
    {
      gallery && gallery.length > 0 && (
        <SwiperCarousel client:visible gallery={gallery} />
      )
    }
  </main>
</Layout>

<style is:inline>
  progress::-webkit-progress-bar {
    border-radius: 5px;
    height: 8px;
    filter: drop-shadow(1px 1px 2px rgba(0, 0, 0, 0.9));
  }

  progress::-webkit-progress-value {
    border-radius: 5px;
    background-color: var(--color-amethyst-500);
  }
  progress::-webkit-progress-bar {
    background-color: rgb(35, 5, 77);
  }

  /* ::-webkit-inner-spin-button, ::-webkit-outer-spin-button{
    display: none;
  } */
</style>

<script>
  import "@/components/goals/utils/amount";
</script>
