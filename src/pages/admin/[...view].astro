---
import Layout from "@/layouts/Layout.astro";
import DashboardLayout from "./_components/DahboardLayout.astro";
import Overview from "./_views/Overview.astro";
import Goals from "./_views/Goals.astro";
import Settings from "./_views/Settings.astro";
import Tips from "./_views/Tips.astro";

const views = { overview: Overview, goals: Goals, settings: Settings, tips:Tips } as const;

type ViewKey = keyof typeof views;

// [...view] -> undefined en /dashboard, "goals" en /dashboard/goals
const key = (Astro.params.view ?? "overview") as string;

if (!(key in views)) {
  return Astro.redirect('/404');
}
const View = views[key as ViewKey];
---

<Layout showHeader={false}>
  <DashboardLayout>
    <View slot="dashboard-content" />
  </DashboardLayout>
</Layout>
