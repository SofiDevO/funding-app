{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*",
    "./worker-configuration.d.ts"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*" , "./*"],
      "@components": ["./src/components"],
      "@layouts": ["./src/layouts"],
      "@pages": ["./src/pages"],
      "@assets": ["./src/assets"],
      "@scripts": ["./src/scripts"],
      "@styles": ["./src/styles"],
      "@lib": ["./src/lib"]
    }
  }
}