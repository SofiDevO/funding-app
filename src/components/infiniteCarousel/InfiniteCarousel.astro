---
/**
 * Carrusel infinito (marquee) generico.
 *
 * No conoce el contenido: el encabezado llega por el slot `header` y los items
 * por el slot por defecto. El componente solo aporta el viewport, el track y la
 * animacion.
 *
 * Contrato del consumidor:
 * - Repetir el set de items tres veces con `repeatItems()` para que el loop no
 *   salte al reiniciar la animacion.
 * - Pasar `itemCount` con la cantidad de items de UN set, no del total.
 * - Envolver cada item con `InfiniteCarouselItem`, que agrega la clase estandar
 *   `infinite-carousel__item`. De esa clase depende la pausa del track.
 */
import type { HTMLAttributes } from "astro/types";
import { twMerge } from "tailwind-merge";

type Props = HTMLAttributes<"section"> & {
  /** Cantidad de items de un set (el consumidor renderiza el set x3). */
  itemCount: number;
  /** Segundos que cada item tarda en cruzar el viewport. */
  secondsPerItem?: number;
  /** Tamano de cada item; los items lo heredan via `--item-size`. */
  itemSize?: string;
  /** Separacion entre items; track e items la heredan via `--gap`. */
  gap?: string;
};

const {
  itemCount,
  secondsPerItem = 1.2,
  itemSize = "5.8rem",
  gap = "1rem",
  class: className,
  ...rest
} = Astro.props;

const duration = `${itemCount * secondsPerItem}s`;
---

{
  itemCount > 0 && (
    <section class={twMerge("infinite-carousel", className)} {...rest}>
      <slot name="header" />

      <div
        class="infinite-carousel__slider"
        style={`--item-count: ${itemCount}; --animation-duration: ${duration}; --item-size: ${itemSize}; --gap: ${gap};`}
      >
        <div class="infinite-carousel__track">
          <slot />
        </div>
      </div>
    </section>
  )
}

<style>
  .infinite-carousel {
    width: 100%;
    margin-block: 3rem;
    padding-block: 1rem;
    position: relative;
  }

  .infinite-carousel__slider {
    position: relative;
    width: 100%;
    max-width: 1200px;
    margin-inline: auto;
    overflow-x: hidden;
    overflow-y: clip;
  }

  .infinite-carousel__slider::before,
  .infinite-carousel__slider::after {
    position: absolute;
    top: 252px;
    z-index: 4;
    width: 150px;
    height: 8rem;
    content: "";
    pointer-events: none;
  }

  .infinite-carousel__slider::before {
    left: 0;
    background: linear-gradient(to right, #09060c, rgb(255 255 255 / 0%));
  }

  .infinite-carousel__slider::after {
    right: 0;
    background: linear-gradient(to left, #09060c, rgb(255 255 255 / 0%));
  }

  .infinite-carousel__track {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: var(--gap);
    box-sizing: border-box;
    width: calc((var(--item-size) + var(--gap)) * var(--item-count) * 3);
    margin: 0 auto;
    height: 60dvh;
    animation: infinite-carousel-scroll var(--animation-duration) linear infinite;
  }

  /*
   * Pausa el loop al pasar por un item (o navegar con teclado).
   * `infinite-carousel__item` es la clase estandar del contrato: los items llegan
   * por slot y conservan el scope de su propio componente, por eso es `:global()`.
   */
  .infinite-carousel__track:has(> :global(.infinite-carousel__item:hover)),
  .infinite-carousel__track:has(> :global(.infinite-carousel__item:focus-within)) {
    animation-play-state: paused;
  }

  @keyframes infinite-carousel-scroll {
    from {
      transform: translateX(0);
    }

    to {
      /* Avanza exactamente un set de items para que el loop no salte. */
      transform: translateX(
        calc(-1 * (var(--item-size) + var(--gap)) * var(--item-count))
      );
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .infinite-carousel__track {
      animation: none;
    }
  }
</style>
