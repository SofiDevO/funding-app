---
import Title from "../Title.astro";

interface Comment {
  profilePicture?: string | null;
  userName: string;
  message: string;
  amount: number;
}

interface Props {
  comments: Comment[];
  getTierColors: (quantity: number) => string;
}

const currency = new Intl.NumberFormat("es-ES", {
  style: "currency",
  currency: "USD",
  maximumFractionDigits: 0,
});

const { comments, getTierColors } = Astro.props;
---

<section
  class="comment-strip flex flex-col p-2 gap-4 h-full max-h-145 overflow-auto scrollbar-none"
  transition:name="donor-card"
>
  {comments.map((comment) => {
    const color = getTierColors(comment.amount);
    return (
      <article
        class="comment-card flex flex-col gap-5 transition-colors ease-in-out p-4 rounded-lg"
        style={`background-image: linear-gradient(to right, rgb(140 66 217 / 20%), rgb(106 66 181 / 10%), color-mix(in srgb, ${color} 22%, transparent)); border: 1px solid rgb(255 255 255 / 10%);`}
      >
        <div class="flex items-center gap-1 justify-between bg-">
          <div class="flex items-center gap-2">
            <div class="rounded-full w-8 h-8 overflow-hidden shadow-md">
              <img
                src={
                  comment.profilePicture || "/image/resources/default_user.avif"
                }
                alt={`Profile picture from ${comment.userName}`}
                class="object-cover w-full h-full"
              />
            </div>
            <Title
              as="h3"
              class="text-xs text-left text-white font-bold"
              title={`@${comment.userName}`}
            />
          </div>
          <div
            class={`py-1 px-3  rounded-md flex`}
            style={`background-color: color-mix(in srgb, ${color} 30%, transparent); border: 0.5px solid ${color};`}
          >
            <span
              class="font-bold"
              style={`color:${color}; filter: saturate(150%);
`}
            >
              {currency.format(comment.amount || 0)}
            </span>
          </div>
        </div>
        <p class="text-white text-sm text-pretty italic">{comment.message}</p>
      </article>
    );
  })}
</section>
