---
import Layout from "@/layouts/Layout.astro";
import Form from "@/components/shared/form/Form.astro";
import FormInput from "@/components/shared/form/FormInput.astro";
import Title from "@/components/shared/Title.astro";
---

<Layout title="Inicia sesión" description="Accede a tu cuenta" >
  <main class="flex flex-col w-full h-full">
      <div
      class="flex flex-col items-center justify-center w-full h-full min-h-screen gap-4"
      >
      <Title as="h2" title="Iniciar sesión" isGradient={true} />
      <Form action="/login" novalidate class=" max-w-100">
        <FormInput name="username" type="text" label="Username or email" />
        <FormInput name="password" type="password" label="Password" />
      </Form>
      <p class="text-amethyst-300 flex items-center gap-2 text-sm">
        ¿No tienes cuenta?
        <a
          href="/register"
          class="text-amethyst-500 hover:text-amethyst-400 hover:underline hover:underline-offset-2 transition-colors duration-300"
        >
          Regístrate aquí
        </a>
      </p>
    </div>
  </main>
</Layout>
