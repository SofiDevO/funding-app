{
  "name": "funding-app",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "infisical:pull": "infisical export --env=prod --format=dotenv --output-file=.dev.vars && wrangler dev --port 8787",
    "infisical:push": "infisical secrets set --file=./.dev.vars --env=prod",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "generate-types": "wrangler types",
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "hono": "^4.13.9",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260928.1",
    "wrangler": "^4.143.0"
  }
}
