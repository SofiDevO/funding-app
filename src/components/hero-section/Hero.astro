---
import Title from "../shared/Title.astro";
import LiveSignal from "./LiveSignal.astro";
---

<section
  id="apoyar"
  class="hero flex flex-col justify-center items-center w-full p-4 h-full min-h-[50dvh]"
>
  <div class="w-full max-w-300 flex items-center gap-10 justify-around relative flex-col-reverse md:flex-row">
    <div class="flex flex-col gap-5 max-w-2xl text-left">
      <div class="flex w-fit items-center gap-2">
        <LiveSignal />
      </div>
      <Title
        class="text-left leading-tight"
        title="Haz posible más contenido, más momentos y más comunidad"
        isGradient
      />
      <p class="max-w-xl text-base text-white/80 md:text-lg">
        Tu apoyo me ayuda a seguir creando videos, transmisiones y proyectos con
        más libertad. Puedes aportar con una donación a una meta, invitarme un
        snack o dejar un mensaje que en vivo puede sonar en voz sintetizada para
        celebrar la comunidad.
      </p>
      <div class="flex flex-wrap gap-3 pt-2">
        <a
          href="#metas"
          class="inline-flex items-center justify-center rounded-xl bg-linear-to-r from-amethyst-700 via-violet-800 to-amethyst-950 px-5 py-3 text-sm font-semibold text-white transition hover:scale-[.95]"
        >
          Ver metas
        </a>
        <a
          href="#metas"
          class="inline-flex items-center justify-center rounded-xl bg-linear-to-r from-amethyst-700 via-violet-800 to-amethyst-950 px-5 py-3 text-sm font-semibold text-white transition hover:scale-[.95]"
        >
          Muro de reconocimiento
        </a>
      </div>
    </div>
    <div class="holographic-card__wrapper">
      <div class="holographic-card max-w-95 border border-white/10 bg-white/5 p-3 shadow-2xl shadow-violet-500/10">
        <div
          class="absolute inset-0 -z-1  bg-linear-to-br from-cyan-500/15 via-transparent to-violet-500/20"
          aria-hidden="true"
        ></div>
      </div>
    </div>
  </div>
</section>

<style is:inline>
  .holographic-card {
    --holographic-color-primary: #fac;
    --holographic-color-secondary: #ddccaa;
    --holographic-gradient-position: 50% 50%;
    --holographic-sparkle-position: 50% 50%;
    --holographic-sparkle-opacity: 1;

    width: 80vw;
    height: 100vw;

    @media screen and (min-width: 600px) {
      width: clamp(14vw, 70vh, 25vw);
      height: clamp(25vw, 100vh, 35vw);
    }

    position: relative;
    overflow: hidden;
    margin: 20px;
    z-index: 10;
    touch-action: none;
    isolation: isolate;

    border-radius: 5% / 3.5%;
    box-shadow:
      -5px -5px 5px -5px var(--holographic-color-primary),
      5px 5px 5px -5px var(--holographic-color-secondary),
      -7px -7px 10px -5px transparent,
      7px 7px 10px -5px transparent,
      0 0 5px 0 rgba(255, 255, 255, 0),
      0 55px 35px -20px rgba(0, 0, 0, 0.5);

    transition:
      transform 0.5s ease,
      box-shadow 0.2s ease;
    will-change: transform;

    background-color: #040712;
    background-image: url("../../../public/image/sofi-cat.png");
    background-size: cover;
    background-repeat: no-repeat;
    background-position: 50% 50%;
    transform-origin: center;
  }

  .holographic-card:hover {
    box-shadow:
      -20px -20px 30px -25px var(--holographic-color-primary),
      20px 20px 30px -25px var(--holographic-color-secondary),
      -7px -7px 10px -5px var(--holographic-color-primary),
      7px 7px 10px -5px var(--holographic-color-secondary),
      0 0 13px 4px rgba(255, 255, 255, 0.3),
      0 55px 35px -20px rgba(0, 0, 0, 0.5);
    transition: box-shadow 0.1s ease-out;
  }

  .holographic-card::before,
  .holographic-card::after {
    content: "";
    position: absolute;
    inset: 0;
    background-repeat: no-repeat;
    opacity: 0.5;
    mix-blend-mode: color-dodge;
    transition: all 0.33s ease;
  }

  .holographic-card::before {
    background-position: var(--holographic-gradient-position);
    background-size: 300% 300%;
    background-image: linear-gradient(
      115deg,
      transparent 0%,
      var(--holographic-color-primary) 25%,
      transparent 47%,
      transparent 53%,
      var(--holographic-color-secondary) 75%,
      transparent 100%
    );
    filter: brightness(0.5) contrast(1);
    z-index: 1;
  }

  .holographic-card::after {
    background-image:
      url("../../../public/image/card/sparkles.gif"),
      url("../../../public/image/card/holo.webp"),
      linear-gradient(
        125deg,
        #ff008450 15%,
        #fca40040 30%,
        #ffff0030 40%,
        #00ff8a20 60%,
        #00cfff40 70%,
        #cc4cfa50 85%
      );
    background-position: var(--holographic-sparkle-position);
    background-size: 160%;
    background-blend-mode: overlay;
    z-index: 2;
    filter: brightness(1) contrast(1);
    opacity: 0.75;
  }

  .holographic-card:hover::after {
    opacity: var(--holographic-sparkle-opacity);
  }

  .holographic-card:hover::before {
    background-image: linear-gradient(
      110deg,
      transparent 25%,
      var(--holographic-color-primary) 48%,
      var(--holographic-color-secondary) 52%,
      transparent 75%
    );
    background-position: var(--holographic-gradient-position);
    background-size: 250% 250%;
    opacity: 0.88;
    filter: brightness(0.66) contrast(1.33);
    transition: none;
  }

  .holographic-card:hover::before,
  .holographic-card:hover::after {
    transition: none;
  }

  .holographic-card--animated {
    transition: none;
    animation: holographic-card-tilt 12s ease 0s 1;

    &::before {
      transition: none;
      animation: holographic-gradient 12s ease 0s 1;
    }

    &::after {
      transition: none;
      animation: holographic-sparkle 12s ease 0s 1;
    }
  }

  @keyframes holographic-sparkle {
    0%,
    100% {
      opacity: 0.75;
      background-position: 50% 50%;
      filter: brightness(1.2) contrast(1.25);
    }
    5%,
    8% {
      opacity: 1;
      background-position: 40% 40%;
      filter: brightness(0.8) contrast(1.2);
    }
    13%,
    16% {
      opacity: 0.5;
      background-position: 50% 50%;
      filter: brightness(1.2) contrast(0.8);
    }
    35%,
    38% {
      opacity: 1;
      background-position: 60% 60%;
      filter: brightness(1) contrast(1);
    }
    55% {
      opacity: 0.33;
      background-position: 45% 45%;
      filter: brightness(1.2) contrast(1.25);
    }
  }

  @keyframes holographic-gradient {
    0%,
    100% {
      opacity: 0.5;
      background-position: 50% 50%;
      filter: brightness(0.5) contrast(1);
    }
    5%,
    9% {
      background-position: 100% 100%;
      opacity: 1;
      filter: brightness(0.75) contrast(1.25);
    }
    13%,
    17% {
      background-position: 0% 0%;
      opacity: 0.88;
    }
    35%,
    39% {
      background-position: 100% 100%;
      opacity: 1;
      filter: brightness(0.5) contrast(1);
    }
    55% {
      background-position: 0% 0%;
      opacity: 1;
      filter: brightness(0.75) contrast(1.25);
    }
  }

  @keyframes holographic-card-tilt {
    0%,
    100% {
      transform: rotateZ(0deg) rotateX(0deg) rotateY(0deg);
    }
    5%,
    8% {
      transform: rotateZ(0deg) rotateX(6deg) rotateY(-20deg);
    }
    13%,
    16% {
      transform: rotateZ(0deg) rotateX(-9deg) rotateY(32deg);
    }
    35%,
    38% {
      transform: rotateZ(3deg) rotateX(12deg) rotateY(20deg);
    }
    55% {
      transform: rotateZ(-3deg) rotateX(-12deg) rotateY(-27deg);
    }
  }


  .holographic-card__wrapper {
    perspective: 750px;
  }
</style>

<script is:inline>
  function initializeCards() {
    document.querySelectorAll(".holographic-card").forEach((card) => {
      if (card.dataset.holographicInitialized === "true") return;
      card.dataset.holographicInitialized = "true";

      let animationTimeout;

      card.addEventListener("pointermove", (event) => {
        const bounds = card.getBoundingClientRect();
        const width = bounds.width;
        const height = bounds.height;
        if (width === 0 || height === 0) return;

        const left = event.clientX - bounds.left;
        const top = event.clientY - bounds.top;
        const px = Math.abs(Math.floor((100 / width) * left) - 100);
        const py = Math.abs(Math.floor((100 / height) * top) - 100);
        const pa = 50 - px + (50 - py);

        const gradientX = 50 + (px - 50) / 1.5;
        const gradientY = 50 + (py - 50) / 1.5;
        const sparkleX = 50 + (px - 50) / 7;
        const sparkleY = 50 + (py - 50) / 7;
        const sparkleOpacity = (20 + Math.abs(pa) * 1.5) / 100;
        const rotateX = ((gradientY - 50) / 2) * -1;
        const rotateY = ((gradientX - 50) / 1.5) * 0.5;

        clearTimeout(animationTimeout);
        card.classList.remove("holographic-card--animated");
        card.style.transform = `rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
        card.style.setProperty(
          "--holographic-gradient-position",
          `${gradientX}% ${gradientY}%`,
        );
        card.style.setProperty(
          "--holographic-sparkle-position",
          `${sparkleX}% ${sparkleY}%`,
        );
        card.style.setProperty(
          "--holographic-sparkle-opacity",
          String(sparkleOpacity),
        );
      });

      const resetCard = () => {
        card.style.removeProperty("transform");
        card.style.removeProperty("--holographic-gradient-position");
        card.style.removeProperty("--holographic-sparkle-position");
        card.style.removeProperty("--holographic-sparkle-opacity");
        clearTimeout(animationTimeout);
        animationTimeout = window.setTimeout(() => {
          card.classList.add("holographic-card--animated");
        }, 2500);
      };

      card.addEventListener("pointerleave", resetCard);
      card.addEventListener("pointerup", (event) => {
        if (event.pointerType !== "mouse") resetCard();
      });
      card.addEventListener("pointercancel", resetCard);
    });
  }

  initializeCards();
  document.addEventListener("astro:page-load", initializeCards);
</script>
