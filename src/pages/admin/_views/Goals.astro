---
import Title from "@/components/shared/Title.astro";
import GoalCardAdmin from "../_components/GoalCardAdmin.astro";

import GoalData from "@/data/goals.json";
console.log(GoalData);
---

<main class="flex flex-col w-full h-full max-w-300">
  <div class="grid-container gap-5">
    {
      GoalData.map((data) => (
        <GoalCardAdmin
          title={data.title}
          status={data.status}
          excerpt={data.excerpt}
          image={data.image_url}
        />
      ))
    };
  </div>
</main>

<style is:inline>
  .grid-container {
    margin-top: 2rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(450px, 1fr));
    gap: 1rem;
    width: 100%;
  }
  @media screen and (max-width: 768px) {
    .grid-container {
      gap: 2rem;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    }
  }
</style>
