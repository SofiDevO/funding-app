---
import UserHeader from "./UserHeader.astro";

// const { user } = Astro.locals
const user = {
  username: "sofidev",
  avatar_url: "/image/profile.png",
  email: "correo@falso.com",
};

const avatar = user.avatar_url
  ? user.avatar_url
  : "https://www.shareicon.net/data/512x512/2016/05/24/770117_people_512x512.png";
---

<aside id="dashboard-sidebar" class="sidebar active" data-sidebar>
  <button
    id="dashboard-sidebar-toggle"
    class="sidebar-toggle"
    type="button"
    data-sidebar-toggle
    aria-controls="dashboard-sidebar"
    aria-expanded="true"
    aria-label="Replegar menú lateral"
  >
    <iconify-icon
      icon="akar-icons:panel-right"
      width="24"
      height="24"
      style="color: rgb(130, 54, 230)"></iconify-icon>
  </button>
  <UserHeader {...user} {avatar} />
  <slot name="navmenu" />
  <footer class="sidebar-footer">
    <a href="/admin/settings">
      <iconify-icon icon="solar:settings-bold-duotone" width="20" height="20"
      ></iconify-icon>
      <span class="text text-sm">Ajustes</span></a
    >
    <a class="logout" href="/logout">
      <iconify-icon icon="majesticons:logout" width="20" height="20"
      ></iconify-icon>
      <span class="text text-sm">Salir</span></a
    >
  </footer>
</aside>

<style>
  .sidebar {
    grid-area: sidebar;
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
    background-color: rgba(27, 6, 61, 0.802);
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    padding: var(--sidebar-padding, 0.5rem);
    border-right: 1px solid #e6e0ee14;
    @media screen and (max-width: 768px) {
      position: absolute;
      width: 100%;
      background: black;
      z-index: 300;
      padding: 1rem;
      transform: translateX(-100%);
      transition: transform 0.5s ease-in-out;
    }

    .sidebar-toggle {
      position: absolute;
      top: 1rem;
      justify-content: center;
      cursor: pointer;
      z-index: 999;
      right: -14px;
      width: fit-content;
      @media screen and (max-width: 768px) {
        display: none;
      }
    }

    .sidebar-menu ul {
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
    }

    .menu-link {
      display: block;
      padding: 0.5rem 1rem;
      display: flex;
      align-items: center;
      gap: 1rem;
      &:hover,
      &.active {
        color: rgb(6, 239, 185);
        background: linear-gradient(
          90deg,
          rgba(130, 54, 230, 0.271) 0%,
          rgba(255, 255, 255, 0.07) 50%,
          rgba(255, 255, 255, 0.07) 100%
        );
        border-radius: 20px;
      }
    }

    &:not(.active) {
      .menu-link {
        border-radius: 100%;
        padding: 0.7rem;
        justify-content: center;
        width: 35px;
        height: 35px;
        min-width: 35px;
        min-height: 35px;
        &.active {
          justify-content: center;
        }
        @media screen and (max-width: 768px) {
          padding: 0.7rem;
          border-radius: 12px;
          width: 100%;
          height: 35px;
          min-width: 35px;
          min-height: 35px;
        }
      }
      & li {
        display: flex;
        justify-content: center;
      }
    }

    .sidebar-menu ul li a {
      color: #fff;
      text-decoration: none;
      font-weight: 500;
      min-height: 6vh;
    }
    .sidebar-footer {
      display: flex;
      flex-direction: column;
      margin-top: auto;
      gap: 7px;
    }
  }
  .is-active{
    @media screen and (max-width: 768px) {
      transform: translateX(0%);
    }
  }

  footer a {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--text-color);
    text-decoration: none;
    font-weight: 500;
    padding: 0.7rem 0.5rem;
    border-radius: 20px;
    background: linear-gradient(#0ef8a2, #0561ff);
    font-weight: 600;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    &:hover {
      background: linear-gradient(#f80ecd, #05c7f8);
      font-weight: 600;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    & > iconify-icon {
      color: rgb(12, 255, 174);
    }
  }
  .sidebar:not(.active) {
    footer a {
      justify-content: center;
      padding: 0;
    }
  }
</style>
<style is:global>
  @media (width >= 768px) {
    .sidebar:not(.active) .sidebar-footer {
      a {
        justify-content: center;
        padding: 1.5rem;
      }
      a .text {
        display: none;
      }
    }
  }
</style>
<script is:inline>
  function initSidebar() {
    const sidebar = document.querySelector("[data-sidebar]");
    const toggles = document.querySelectorAll("[data-sidebar-toggle]");
    if (!sidebar || toggles.length === 0) return;

    const syncAria = () => {
      const expanded = sidebar.classList.contains("active");
      toggles.forEach((toggle) => {
        toggle.setAttribute("aria-expanded", String(expanded));
        toggle.setAttribute(
          "aria-label",
          expanded ? "Replegar menú lateral" : "Expandir menú lateral",
        );
      });
    };

    // Estado inicial en móvil: replegado. Solo se aplica una vez por carga.
    if (window.innerWidth < 768) {
      sidebar.classList.remove("active");
    }
    syncAria();

    toggles.forEach((toggle) => {
      if (toggle.dataset.sidebarBound === "true") return;
      toggle.dataset.sidebarBound = "true";
      toggle.addEventListener("click", () => {
        sidebar.classList.toggle("active");
        syncAria();
      });
    });
  }

  document.addEventListener("astro:page-load", initSidebar);
  initSidebar();
</script>
