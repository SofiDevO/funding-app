---
import Title from "@/components/shared/Title.astro";

interface Props {
  id: string;
  title: string;
  image_url: string;
}

const { id, title, image_url } = Astro.props as Props;
---

<div
  class="flex items-center w-full h-60 md:h-80 overflow-hidden group bg-center bg-cover bg-no-repeat relative rounded-xl"
  transition:name={`goal-image-${id}`}
  transition:persist
  style={`background-image:url(${image_url})`}
>
  <a
    href="/"
    transition:name={`index-link-${id}`}
    class="z-20 absolute top-4 left-4 text-gray-200 text-lg flex items-center gap-2 w-fit font-extrabold hover:text-cyan-400 transition-colors cursor-pointer group"
  >
    <iconify-icon
      class="group-hover:-translate-x-1"
      width="25"
      height="25"
      icon="akar-icons:arrow-left"></iconify-icon>
    Volver</a
  >
  <Title
    title={title}
    isGradient={true}
    class="z-20 text-3xl md:text-5xl font-extrabold mb-10 absolute top-50 left-[50%] translate-x-[-50%]"
    transition:name={`goal-title-${id}`}
  />
  <div
    class="overlay backdrop-blur bg-linear-to-t from-black/98 via-black/80 to-black/50 z-10 absolute w-full h-full pointer-events-none"
  >
  </div>
</div>
