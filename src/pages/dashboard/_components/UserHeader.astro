---
const { username, avatar, email } = Astro.props;
const maskedEmail =
  email && email.includes("@") ? `*******@${email.split("@")[1]}` : "*******";
---

<header class="profile-header">
  <div class="avatar-container">
    <img
      src={avatar}
      alt={`Avatar of ${username}`}
      class="avatar-image"
      aria-label={`Avatar of ${username}`}
    />
  </div>

  {
    username && (
      <div class="profile-content">
        <a href="dashboard/edit">
          <p class="avatar-username">{username}</p>
        </a>
        <span class="email-row" data-email-container>
          <span
            class="avatar-email"
            data-email-text
            data-email-full={email}
            data-email-masked={maskedEmail}
          >
            {maskedEmail}
          </span>
          <button
            type="button"
            class="email-toggle"
            data-email-toggle
            aria-pressed="false"
            aria-label="Mostrar email"
          >
            <iconify-icon icon="andrsrxn:eye" width="13" height="13" />
          </button>
        </span>
      </div>
    )
  }
</header>

<script>
  import "@/components/shared/utils/toggle-email";
</script>

<style>
  .profile-header {
    --level-color: rgb(7, 255, 152);
    display: flex;
    align-items: center;
    justify-content: flex-start;
    position: relative;
    padding: 1rem .3rem 1rem .2rem;
    gap: 1rem;

    .avatar-container {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 50px;
      height: 50px;
      min-width: 50px;
      min-height: 50px;
      border-radius: 50%;
      padding: 0.2rem;
      position: relative;
      border: solid 3px var(--level-color);

      .avatar-image {
        object-fit: cover;
        width: 100%;
        height: 100%;
        border-radius: 50%;
      }
    }
  }

  .avatar-tooltip {
    transform: translateY(-50%);
    padding: 0.5rem 1rem;
    background: #8751e9;
    color: white;
    font-size: .4rem;
    transition: opacity 0.4s ease;
    border-radius: 3px;
    min-width: fit-content;
    text-wrap: nowrap;
  }
  .profile-content {
    display: flex;
    flex-direction: column;
    color: white;
  }
  .avatar-username {
    font-weight: 600;
    font-size: 1.2rem;
    background: linear-gradient(
      90deg,
      rgb(1, 255, 200) 0%,
      rgb(194, 0, 253) 100%
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    text-fill-color: transparent;
  }
  .avatar-email {
    color: white;
    font-size: .8rem;
  }
  .email-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .email-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    padding: 0.15rem;
    cursor: pointer;
    color: white;
    opacity: 0.7;
    transition: opacity 0.2s ease;
    &:hover {
      opacity: 1;
    }
    &.is-visible {
      opacity: 1;
      color: rgb(7, 255, 152);
    }
  }
</style>
<style is:global>
  @media (width >= 768px) {
    .sidebar:not(.active) .profile-header {
      opacity: 0;
    }
  }
</style>
