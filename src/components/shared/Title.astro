---
import { twMerge } from 'tailwind-merge';

type HeadingTag = "h1" | "h2" | "h3" | "h4" | "h5" | "h6";

type Props = {
	as?: HeadingTag;
	title: string;
    class?: string;
    isGradient?: boolean;
};

const baseStyles = {
    h1: "font-bold text-4xl text-center ",
    h2: "font-bold text-3xl text-center ",
    h3: "font-bold text-2xl text-center ",
    h4: "font-bold text-xl text-center ",
    h5: "font-bold text-lg text-center ",
    h6: "font-bold text-base text-center ",
};
const { as: Tag = "h1", title, isGradient = false, class: className, ...rest } = Astro.props as Props;
---


<Tag
    {...rest}
    class={twMerge(
        baseStyles[Tag as HeadingTag],
        isGradient && "bg-linear-to-r from-blue-500 via-amethyst-500 to-teal-500 bg-clip-text text-transparent",
        className,
    )}
>
    {title}
</Tag>