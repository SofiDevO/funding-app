---
import Layout from "@/layouts/Layout.astro";

import Form from "@/components/shared/form/Form.astro";
import FormInput from "@/components/shared/form/FormInput.astro";
import Title from "@/components/shared/Title.astro";
---

<Layout title="Registrate">
  <main
    class="flex flex-col items-center justify-center w-full h-full min-h-screen"
  >
    <section
      class="flex flex-col w-full h-ful gap-4 items-center justify-center"
    >
      <Title transition:name="register-btn" as="h2" title="Crear una cuenta" isGradient={true} />
      <Form transition:animate={"slide"}transition:name="form-register" novalidate class="max-w-100">
        <FormInput name="username" type="text" label="Username" />
        <FormInput name="email" type="email" label="Email" />
        <FormInput name="password" type="password" label="Password" />
        <FormInput
          name="confirm_password"
          type="password"
          label="Confirm Password"
        />
      </Form>
      <p class="text-amethyst-300 flex items-center gap-2 text-sm mt-4">
        ¿Ya tienes cuenta?
        <a
        transition:name="login-btn"
        transition:persist
          href="/login"
          class="text-amethyst-500 hover:text-amethyst-400 hover:underline hover:underline-offset-2 transition-colors duration-300"
        >
          Inicia sesión aquí
        </a>
      </p>
    </section>
  </main>
</Layout>
