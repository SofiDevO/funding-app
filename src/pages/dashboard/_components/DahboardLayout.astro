---
import "../styles/dashboard.css";
import SideBar from "./SideBar.astro";
import NavBar from "./NavBar.astro";
const menu = [
  {
    href: "/",
    icon: "solar:house-bold",
    text: "Inicio",
  },
  {
    href: "/dashboard",
    icon: "boxicons:dashboard-alt-filled",
    text: "overview",
  },
  {
    href: "/dashboard/goals",
    icon: "mage:goals",
    text: "Goals",
  },
];
---

<div class="dashboard-layout">
  <SideBar>
    <NavBar slot="navmenu" {menu} pathName={Astro.url.pathname} />
  </SideBar>
  <main class="dashboard-main">
    <slot name="dashboard-content" />
  </main>
</div>
