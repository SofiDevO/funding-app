---
const { pathName, menu } = Astro.props;
type MenuItem = {
  href: string
  icon: string
  text: string
};
---

<nav class="sidebar-menu">
  <ul>
    {
      menu.map((item: MenuItem) => (
        <li>
          <a
        class={`menu-link ${item.href === pathName ? "active" : ""}`}
            href={item.href}
            data-astro-prefetch="hover"
          >
            <iconify-icon
              icon={item.icon}
              width="20"
              height="20"
              style="color: var(--accent-color)"
            />
            <span class="text text-sm">{item.text}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style is:global>
@media (width >= 768px) {
  .sidebar:not(.active) .text {
    display: none;
  }
}
</style>