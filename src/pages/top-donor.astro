---
import Layout from "@/layouts/Layout.astro";
import Title from "@/components/shared/Title.astro";
import topDonors from "@/data/top-donors.json";
import donorMessages from "@/data/messages.json";

import CommentCard from "@/components/shared/comments/CommentCard.astro";
import TopDonorTable from "./admin/_components/top-donor/TopDonorTable.astro";

interface TopDonor {
  userName: string;
  profilePicture: string | null;
  total: number;
  donationCount: number;
  lastDonationAt: string;
}
interface donorMessages {
  userName: string;
  profilePicture: string | null;
  message: string;
  amount: number;
  createdAt: string;
}

const donors = topDonors as TopDonor[];
const comments = donorMessages as donorMessages[];
const tierColors = ["#00c950", "#ffb900", "#ff8904", "#ff6467"];

function getTierColors(quantity: number): string {
  if (quantity > 50) return tierColors[3];
  if (quantity > 20) return tierColors[2];
  if (quantity > 8) return tierColors[1];
  if (quantity >= 1) return tierColors[0];
  return "#ffffff";
}
---

<Layout title="Top Donantes">
  <main class="h-full w-full flex justify-center gap-4 min-h-screen px-3 py-2 pt-20">

      <TopDonorTable  {donors} {getTierColors}/>
      <CommentCard comments={comments} {getTierColors} />
  </main>
</Layout>
