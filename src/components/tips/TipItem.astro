---
/**
 * Item del carrusel de tips: imagen del producto y tooltip con precio, stepper
 * de cantidad y boton "Invitar". Los estilos de la caja del item (tamano,
 * rotacion, hover) viven en `InfiniteCarouselItem`.
 */
import InfiniteCarouselItem from "@/components/infiniteCarousel/InfiniteCarouselItem.astro";
import { MIN_QUANTITY } from "./utils/quantity";

interface Props {
  id: string;
  productName: string;
  productImage: string;
  price: number;
}

const { id, productName, productImage, price } = Astro.props;

const money = new Intl.NumberFormat("en-US", {
  style: "currency",
  currency: "USD",
});
---

<InfiniteCarouselItem
  class="tip-item"
  data-tip-card
  data-tip-id={id}
  data-tip-price={price}
  data-tip-quantity={MIN_QUANTITY}
  aria-label={`Regalar ${productName}`}
  tabindex="0"
>
  <img
    class="tip-item__image"
    src={productImage}
    alt={productName}
    width="40"
    height="40"
    loading="lazy"
    decoding="async"
  />

  <div
    class="tip-item__tooltip"
    role="group"
    aria-label={`Cantidad y precio de ${productName}`}
  >
    <p class="tip-item__price">
      {money.format(price)}
      <span class="tip-item__unit">USD c/u</span>
    </p>

    <div class="tip-item__stepper">
      <button
        type="button"
        class="tip-item__step"
        data-tip-minus
        aria-label={`Quitar una unidad de ${productName}`}
        disabled
      >
        <span aria-hidden="true">−</span>
      </button>

      <output class="tip-item__qty" data-tip-qty aria-live="polite">
        {MIN_QUANTITY}
      </output>

      <button
        type="button"
        class="tip-item__step"
        data-tip-plus
        aria-label={`Agregar una unidad de ${productName}`}
      >
        <span aria-hidden="true">+</span>
      </button>
    </div>

    <button type="button" class="tip-item__invite" data-tip-invite>
      Invitar
      <span class="tip-item__total" data-tip-total>
        {money.format(price)}
      </span>
    </button>
  </div>
</InfiniteCarouselItem>

<style>
  .tip-item__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: none;
  }

  .tip-item__tooltip {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 3;
    display: flex;
    flex-direction: column;
    width: 12.5rem;
    padding: 0.5rem;
    border: 1px solid rgb(170 104 223 / 32%);
    border-radius: 0.9rem;
    background: #0d0814;
    box-shadow: 0 18px 40px rgb(0 0 0 / 55%);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translate(-50%, -50%) scale(0.95);
    transform-origin: center;
    transition:
      opacity 0.18s ease,
      transform 0.18s ease,
      visibility 0.18s;
  }

  .tip-item:hover .tip-item__tooltip,
  .tip-item:focus-within .tip-item__tooltip {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translate(-50%, -124%) scale(1);
  }

  .tip-item__price {
    display: flex;
    align-items: baseline;
    gap: 0.2rem;
    color: #fff;
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1;
    text-align: left;
  }

  .tip-item__unit {
    color: rgb(255 255 255 / 45%);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .tip-item__stepper {
    display: grid;
    grid-template-columns: 2rem 1fr 2rem;
    align-items: center;
    margin-top: 0.5rem;
    padding: 0.2rem;
    border: 1px solid rgb(170 104 223 / 22%);
    border-radius: 0.75rem;
    background: rgb(255 255 255 / 3%);
  }

  .tip-item__step {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1px solid rgb(170 104 223 / 22%);
    border-radius: 0.6rem;
    background: transparent;
    color: #f5eefe;
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease;

    &:hover:not(:disabled) {
      border-color: rgb(170 104 223 / 55%);
      background: rgb(170 104 223 / 18%);
    }

    &:disabled {
      opacity: 0.35;
      cursor: not-allowed;
    }
  }

  .tip-item__qty {
    min-width: 1.5rem;
    color: #fff;
    font-size: 1rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    text-align: center;
  }

  .tip-item__invite {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    margin-top: 0.5rem;
    padding: 0.5rem 0.75rem;
    border: 0;
    border-radius: 0.7rem;
    background: var(--color-amethyst-600);
    color: #fff;
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      transform 0.2s ease;

    &:hover {
      background: var(--color-amethyst-700);
    }

    &:active {
      transform: scale(0.98);
    }
  }

  .tip-item__total {
    padding-inline-start: 0.5rem;
    border-inline-start: 1px solid rgb(255 255 255 / 35%);
    font-variant-numeric: tabular-nums;
  }

  .tip-item__step:focus-visible,
  .tip-item__invite:focus-visible {
    outline: 2px solid var(--color-amethyst-300);
    outline-offset: 2px;
  }
</style>
