---
import HoloCard from "../shared/holo-cards/HoloCard.astro";
import Title from "../shared/Title.astro";
import LiveSignal from "./LiveSignal.astro";
---

<section
  id="apoyar"
  class="hero flex flex-col justify-center items-center w-full p-4 h-full min-h-[50dvh]"
>
  <div class="w-full max-w-300 flex items-center gap-10 justify-around relative flex-col-reverse md:flex-row">
    <div class="flex flex-col gap-5 max-w-2xl text-left">
      <div class="flex w-fit items-center gap-2">
        <LiveSignal />
      </div>
      <Title
        class="text-left leading-tight"
        title="Haz posible más contenido, más momentos y más comunidad"
        isGradient
      />
      <p class="max-w-xl text-base text-white/80 md:text-lg">
        Tu apoyo me ayuda a seguir creando videos, transmisiones y proyectos con
        más libertad. Puedes aportar con una donación a una meta, invitarme un
        snack o dejar un mensaje que en vivo puede sonar en voz sintetizada para
        celebrar la comunidad.
      </p>
      <div class="flex flex-wrap gap-3 pt-2">
        <a
          href="#metas"
          class="inline-flex items-center justify-center rounded-xl bg-linear-to-r from-amethyst-700 via-violet-800 to-amethyst-950 px-5 py-3 text-sm font-semibold text-white transition hover:scale-[.95]"
        >
          Ver metas
        </a>
        <a
          transition:name="top-donor-title"
          href="/top-donor"
          class="inline-flex items-center justify-center rounded-xl bg-linear-to-r from-amethyst-700 via-violet-800 to-amethyst-950 px-5 py-3 text-sm font-semibold text-white transition hover:scale-[.95]"
        >
          Muro de reconocimiento
        </a>
      </div>
    </div>
    <HoloCard />
  </div>
</section>
