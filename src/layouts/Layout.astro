---
import GradientBg from "@/components/gradient-bg/GradientBg.astro";
import BaseHead from "../components/BaseHead.astro";
import Header from "@/components/Header.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  url?: string;
  type?: "website" | "article" | "profile";
}

const {
  title,
  description,
  image = "/og-default.png",
  url = Astro.url.href,
  type = "website",
} = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead {description} {image} />
    <slot name="head" />
  </head>
  <GradientBg>
    <body class="">
      <GradientBg>
        <Header />
        <slot />
      </GradientBg>
    </body>
  </GradientBg>
</html>
