---
type TipStatus = "active" | "inactive";

interface TipFormValues {
  id?: string;
  title?: string;
  productName?: string;
  productImage?: string;
  category?: string | null;
  price?: number;
  status?: TipStatus;
  sortOrder?: number;
}

interface Props {
  tip?: TipFormValues;
  mode?: "create" | "edit";
  submitLabel?: string;
}

const { tip, mode = tip?.id ? "edit" : "create", submitLabel } = Astro.props;
const isEdit = mode === "edit";
const formId = `tip-form-${tip?.id ?? "new"}`;
const actionLabel = submitLabel ?? (isEdit ? "Actualizar tip" : "Crear tip");
const values = {
  title: tip?.title ?? "",
  productName: tip?.productName ?? "",
  productImage: tip?.productImage ?? "",
  category: tip?.category ?? "",
  price: tip?.price ?? "",
  status: tip?.status ?? "active",
  sortOrder: tip?.sortOrder ?? 0,
};
const statusOptions: Array<{ value: TipStatus; label: string }> = [
  { value: "active", label: "Activo" },
  { value: "inactive", label: "Inactivo" },
];
const labelClass = "text-sm font-semibold text-slate-700";
const fieldClass =
  "w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none transition focus:border-amethyst-500 focus:ring-2 focus:ring-amethyst-500/30";
const hintClass = "text-xs text-slate-500";
const fieldWrapperClass = "flex flex-col gap-2";
---

<div
  class="w-full max-w-5xl"
  data-tip-form-shell
  data-tip-mode={mode}
  data-tip-id={tip?.id ?? ""}
>
  <form
    id={formId}
    class="grid gap-5 rounded-xl border border-slate-300/40 bg-slate-50 p-6 text-slate-800 shadow-md md:grid-cols-2"
    data-tip-form
  >
    <div class={fieldWrapperClass}>
      <label for={`${formId}-title`} class={labelClass}>Título</label>
      <input
        id={`${formId}-title`}
        name="title"
        type="text"
        class={fieldClass}
        value={values.title}
        required
        minlength="3"
        maxlength="80"
        autocomplete="off"
      />
    </div>

    <div class={fieldWrapperClass}>
      <label for={`${formId}-productName`} class={labelClass}>Nombre del producto</label>
      <input
        id={`${formId}-productName`}
        name="productName"
        type="text"
        class={fieldClass}
        value={values.productName}
        required
        minlength="3"
        maxlength="80"
        autocomplete="off"
      />
    </div>

    <div class={`${fieldWrapperClass} md:col-span-2`}>
      <label for={`${formId}-productImageFile`} class={labelClass}>Imagen del producto</label>
      <div class="flex flex-wrap items-start gap-4">
        <img
          src={values.productImage || "/image/goal.png"}
          alt="Vista previa del producto"
          class="h-24 w-36 rounded-md border border-slate-300 bg-slate-200 object-contain"
          data-tip-cover-preview
        />
        <div class="flex min-w-56 flex-col gap-2">
          <input
            id={`${formId}-productImageFile`}
            name="imageFile"
            type="file"
            accept="image/*"
            class="block w-full text-sm text-slate-600 file:mr-3 file:cursor-pointer file:rounded-md file:border-0 file:bg-amethyst-950 file:px-3 file:py-2 file:text-sm file:font-bold file:text-white hover:file:bg-amethyst-800"
            data-tip-cover-input
            required={!values.productImage}
          />
          <p class={hintClass}>La imagen se sube a R2 y se guarda su URL pública.</p>
          <p class={hintClass} data-tip-cover-name hidden></p>
        </div>
      </div>
      <input type="hidden" name="productImage" value={values.productImage} data-tip-cover-url />
    </div>

    <div class={fieldWrapperClass}>
      <label for={`${formId}-category`} class={labelClass}>Categoría</label>
      <input
        id={`${formId}-category`}
        name="category"
        type="text"
        class={fieldClass}
        value={values.category}
        maxlength="50"
        autocomplete="off"
      />
      <p class={hintClass}>Opcional. Puedes crear categorías libremente.</p>
    </div>

    <div class={fieldWrapperClass}>
      <label for={`${formId}-price`} class={labelClass}>Precio unitario (USD)</label>
      <input
        id={`${formId}-price`}
        name="price"
        type="number"
        class={fieldClass}
        value={values.price}
        required
        min="1"
        max="999"
        step="0.01"
        inputmode="decimal"
      />
      <p class={hintClass}>El precio mínimo es $1.00.</p>
    </div>

    <div class={fieldWrapperClass}>
      <label for={`${formId}-status`} class={labelClass}>Estado</label>
      <select id={`${formId}-status`} name="status" class={fieldClass} required>
        {statusOptions.map((option) => (
          <option value={option.value} selected={option.value === values.status}>
            {option.label}
          </option>
        ))}
      </select>
    </div>

    <div class={fieldWrapperClass}>
      <label for={`${formId}-sortOrder`} class={labelClass}>Orden en el inicio</label>
      <input
        id={`${formId}-sortOrder`}
        name="sortOrder"
        type="number"
        class={fieldClass}
        value={values.sortOrder}
        required
        min="0"
        step="1"
        inputmode="numeric"
      />
      <p class={hintClass}>Los números menores aparecen primero.</p>
    </div>
  </form>

  <div class="flex flex-wrap items-center gap-3 pt-4">
    <button
      type="submit"
      form={formId}
      class="rounded-md bg-amethyst-950 px-4 py-2 text-sm font-bold text-white transition hover:bg-amethyst-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amethyst-500 disabled:cursor-not-allowed disabled:opacity-60"
      data-tip-submit
    >
      {actionLabel}
    </button>
    {isEdit && (
      <button
        type="button"
        class="rounded-md border border-red-300 bg-red-50 px-4 py-2 text-sm font-bold text-red-700 transition hover:bg-red-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-500 disabled:cursor-not-allowed disabled:opacity-60"
        data-tip-delete
      >
        Eliminar
      </button>
    )}
  </div>

  <p
    class="mt-3 rounded-md border border-red-300 bg-red-50 px-3 py-2 text-sm text-red-700"
    data-tip-error
    role="alert"
    hidden
  ></p>
</div>

<script>
  import "./tips-form";
</script>
