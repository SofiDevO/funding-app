---
import "../styles/dashboard.css";
import SideBar from "./SideBar.astro";
import NavBar from "./NavBar.astro";
import HamburgerButton from "./HamburgerButton.astro";
const menu = [
  {
    href: "/",
    icon: "solar:house-bold",
    text: "Inicio",
  },
  {
    href: "/admin",
    icon: "boxicons:dashboard-alt-filled",
    text: "overview",
  },
  {
    href: "/admin/goals",
    icon: "mage:goals",
    text: "Goals",
  },
  {
    href: "/admin/tips",
    icon: "hugeicons:tips",
    text: "Tips",
  }
];

---

<div class="dashboard-layout">
  <SideBar>
    <NavBar slot="navmenu" {menu} pathName={Astro.url.pathname} />
  </SideBar>
  <main class="dashboard-main flex flex-col w-full h-full items-center ">
    <slot name="dashboard-content" />
    <HamburgerButton/>
  </main>
</div>
